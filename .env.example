# ══════════════════════════════════════════════════════════════════
#  BRIGHTAL — környezeti beállítások
#  Használat:  cp .env.example .env
# ══════════════════════════════════════════════════════════════════

# ---------- alap ----------
PORT=3000
NODE_ENV=development
# A bolt nyilvános címe. A Barion ide irányít vissza, és ide küldi a callbacket.
PUBLIC_URL=http://localhost:3000
# Alapértelmezett nyelv: hu vagy en (a látogató bármikor válthat)
DEFAULT_LANG=hu

# ---------- márka ----------
SHOP_NAME=BRIGHTAL
SHOP_EMAIL=hello@brightal.hu
SHOP_PHONE=+36 1 234 5678
SHOP_ADDRESS=Budapest, Váci utca 1., 1052
VAT_RATE=0.27
# Ennyi órán belül ígérünk árajánlatot
REVIEW_HOURS=1
# Gyártási idő munkanapban
PRODUCTION_DAYS_MIN=10
PRODUCTION_DAYS_MAX=14

# ---------- pénznem ----------
# HUF vagy EUR
CURRENCY=HUF

# ---------- képfeltöltés ----------
UPLOAD_MAX_MB=8
UPLOAD_MAX_FILES=4

# ══════════════════════════════════════════════════════════════════
#  ADMIN BELÉPÉS
#  A bejelentkezési űrlapon add meg ezeket (ugyanaz az űrlap, mint
#  az ügyfeleknél). Belépés után az /admin oldalra kerülsz.
#
#  ⚠  AZ ALAPÉRTELMEZETT JELSZÓ GYENGE — élesítés előtt cseréld le!
# ══════════════════════════════════════════════════════════════════
ADMIN_USERNAME=20000902
ADMIN_PASSWORD=12345
ADMIN_NAME=Admin
# Ide érkezik az értesítés minden új kérésről
ADMIN_EMAIL=hello@brightal.hu

# ══════════════════════════════════════════════════════════════════
#  BARION
# ══════════════════════════════════════════════════════════════════
# test = https://api.test.barion.com (SANDBOX) | prod = éles
BARION_ENV=test
# POSKey: Barion admin → Shopok → (shop) → Szerkesztés → Secret key
# Üresen hagyva a szerver SZIMULÁCIÓS módban indul (nincs valódi fizetés).
BARION_POS_KEY=
# A Barion-fiókod e-mail címe (a pénz címzettje)
BARION_PAYEE=
BARION_SHOP_ID=
BARION_PIXEL_ID=
BARION_LOCALE=hu-HU
BARION_GUEST_CHECKOUT=true
BARION_FUNDING_SOURCES=All
# FONTOS: .NET TimeSpan formátum (d.hh:mm:ss), NEM ISO 8601!
BARION_PAYMENT_WINDOW=1.00:00:00

# ══════════════════════════════════════════════════════════════════
#  GOOGLE BELÉPÉS (opcionális)
# ══════════════════════════════════════════════════════════════════
# console.cloud.google.com → APIs & Services → Credentials
# → Create OAuth client ID → Web application
# Authorized JavaScript origins: http://localhost:3000 (+ éles domain)
GOOGLE_CLIENT_ID=

# ══════════════════════════════════════════════════════════════════
#  E-MAIL (opcionális)
#  Kikapcsolva a levelek a konzolra és a data/mail-outbox.log fájlba
#  kerülnek — a folyamat így is teljesen működik.
# ══════════════════════════════════════════════════════════════════
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=BRIGHTAL <hello@brightal.hu>

# ══════════════════════════════════════════════════════════════════
#  PINTEREST (opcionális)
#  Saját ötlettábla beágyazása. Teljes URL, pl.:
#  https://www.pinterest.com/felhasznalo/tabla-neve/
# ══════════════════════════════════════════════════════════════════
PINTEREST_BOARD_HU=
PINTEREST_BOARD_EN=

# ══════════════════════════════════════════════════════════════════
#  MUNKAMENET
#  Generálás: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ══════════════════════════════════════════════════════════════════
SESSION_SECRET=
SESSION_MAX_AGE_DAYS=30

# ══════════════════════════════════════════════════════════════════
#  CÉGADATOK — az impresszumhoz, ÁSZF-hez, adatkezelési tájékoztatóhoz
#  ─────────────────────────────────────────────────────────────────
#  Ezek NEM titkos adatok: jogszabály kötelezi a közzétételüket.
#  Amit üresen hagysz, az a jogi oldalon piros [KITÖLTENDŐ] jelölésként
#  látszik — így pontosan látod, mi hiányzik még.
#
#  ⚠  A Barion a bolt jóváhagyása előtt EMBERI KÉZZEL átnézi az
#     oldalt. Hiányos impresszummal elutasítja.
# ══════════════════════════════════════════════════════════════════
COMPANY_NAME=
COMPANY_SHORT_NAME=BRIGHTAL
COMPANY_ADDRESS=
COMPANY_MAILING_ADDRESS=
COMPANY_TAX_NUMBER=
COMPANY_EU_TAX_NUMBER=
COMPANY_REG_NUMBER=
COMPANY_REG_AUTHORITY=
COMPANY_REPRESENTATIVE=
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT=
COMPANY_EMAIL=
COMPANY_PHONE=

# Tárhelyszolgáltató (Ekertv. 4. § alapján kötelező adat)
HOSTING_NAME=Hetzner Online GmbH
HOSTING_ADDRESS=Industriestr. 25, 91710 Gunzenhausen, Németország
HOSTING_EMAIL=info@hetzner.com

# Békéltető testület — a székhely szerint illetékeset add meg
ARBITRATION_BOARD=Budapesti Békéltető Testület
ARBITRATION_ADDRESS=1016 Budapest, Krisztina krt. 99. III. em. 310.
ARBITRATION_EMAIL=bekelteto.testulet@bkik.hu

# A jogi szövegek hatálybalépésének dátuma (ÉÉÉÉ-HH-NN)
LEGAL_EFFECTIVE_FROM=

# ══════════════════════════════════════════════════════════════════
#  ADMIN JELSZÓ HASH-ELVE  (ajánlott élesben)
#  Előállítás:   npm run hash-password
#  Ha ez ki van töltve, a fenti ADMIN_PASSWORD figyelmen kívül marad.
# ══════════════════════════════════════════════════════════════════
ADMIN_PASSWORD_HASH=

# ══════════════════════════════════════════════════════════════════
#  SZÁMLÁZÁS  (NAV online számla — élesben kötelező)
#  Kikapcsolva a rendszer csak naplóz: data/invoice-outbox.log
# ══════════════════════════════════════════════════════════════════
INVOICE_ENABLED=false
# szamlazz | billingo
INVOICE_PROVIDER=szamlazz
# Számlázz.hu → Beállítások → Számla Agent → Agent kulcs
SZAMLAZZ_AGENT_KEY=
# Billingo v3 → Beállítások → API kulcsok
BILLINGO_API_KEY=
BILLINGO_BLOCK_ID=
BILLINGO_BANK_ACCOUNT_ID=
# az e-számla kiküldése a vevőnek a szolgáltatón keresztül
INVOICE_SEND_TO_CUSTOMER=true
INVOICE_PAYMENT_METHOD=bankkártya
# ÁFA-kulcs a számlán. Alanyi adómentesnél: AM (és VAT_RATE=0)
INVOICE_VAT_RATE_LABEL=27
INVOICE_ITEM_NAME=Egyedi készítésű gyűrű
INVOICE_COMMENT=

# ══════════════════════════════════════════════════════════════════
#  COOKIE / HOZZÁJÁRULÁS
#  true esetén a Barion Pixel CSAK a látogató hozzájárulása után tölt be.
# ══════════════════════════════════════════════════════════════════
PIXEL_REQUIRES_CONSENT=true
