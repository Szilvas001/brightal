# ══════════════════════════════════════════════════════════════════
#  BRIGHTAL — ÉLES (production) beállítások
# ══════════════════════════════════════════════════════════════════
#  Ez a fájl a szerverre való. Használat:
#      cp .env.production.example .env
#      nano .env          # töltsd ki a <...> részeket
#      chmod 600 .env
#
#  ⚠  EZT A FÁJLT KITÖLTVE SOHA NE TEDD GIT REPÓBA, ÉS NE MÁSOLD BE
#     CHATBE — a POSKey-jel bárki fizetést indíthat a nevedben.
#     A .gitignore már kizárja a .env-et.
#
#  Jelölések:
#     <...>          = neked kell kitölteni
#     [nyilvános]    = nem titok, kikerülhet a böngészőbe is
#     [TITKOS]       = soha ne oszd meg senkivel
# ══════════════════════════════════════════════════════════════════


# ══════════════════════════════════════════════════════════════════
#  1. ALAP
# ══════════════════════════════════════════════════════════════════
PORT=3000
NODE_ENV=production

# A bolt nyilvános címe. A Barion ide irányít vissza és ide küldi a
# callbacket — HTTPS KÖTELEZŐ, záró / nélkül.        [nyilvános]
PUBLIC_URL=https://brightal.hu

DEFAULT_LANG=hu
CURRENCY=HUF


# ══════════════════════════════════════════════════════════════════
#  2. MUNKAMENET                                        [TITKOS]
#  Generálás:  npm run gen-secret
# ══════════════════════════════════════════════════════════════════
SESSION_SECRET=<64 karakteres véletlen érték>
SESSION_MAX_AGE_DAYS=30


# ══════════════════════════════════════════════════════════════════
#  3. ADMIN BELÉPÉS
#  A jelszót NE nyílt szövegként tartsd: npm run hash-password
# ══════════════════════════════════════════════════════════════════
ADMIN_USERNAME=<egyedi felhasználónév, ne "admin">
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=<scrypt$... — npm run hash-password>   # [TITKOS]
ADMIN_NAME=Admin
ADMIN_EMAIL=<ide jönnek az új kérésekről az értesítések>


# ══════════════════════════════════════════════════════════════════
#  4. BOLT ADATAI (a weboldalon jelennek meg)          [nyilvános]
# ══════════════════════════════════════════════════════════════════
SHOP_NAME=BRIGHTAL
SHOP_EMAIL=<hello@brightal.hu>
SHOP_PHONE=<+36 ...>
SHOP_ADDRESS=<a szalon címe>
VAT_RATE=0.27
REVIEW_HOURS=1
PRODUCTION_DAYS_MIN=10
PRODUCTION_DAYS_MAX=14

UPLOAD_MAX_MB=8
UPLOAD_MAX_FILES=4


# ══════════════════════════════════════════════════════════════════
#  5. CÉGADATOK — impresszum, ÁSZF, adatkezelés       [nyilvános]
#  A Barion ezek nélkül NEM hagyja jóvá a boltot.
# ══════════════════════════════════════════════════════════════════
COMPANY_NAME=<pontos cégnév vagy EV név>
COMPANY_SHORT_NAME=BRIGHTAL
COMPANY_ADDRESS=<székhely, irányítószámmal>
COMPANY_MAILING_ADDRESS=<levelezési cím, ha eltér>
COMPANY_TAX_NUMBER=<adószám>
COMPANY_EU_TAX_NUMBER=<közösségi adószám, ha van>
COMPANY_REG_NUMBER=<cégjegyzékszám vagy EV nyilvántartási szám>
COMPANY_REG_AUTHORITY=<pl. Fővárosi Törvényszék Cégbírósága>
COMPANY_REPRESENTATIVE=<képviselő neve>
COMPANY_BANK_NAME=<számlavezető bank>
COMPANY_BANK_ACCOUNT=<bankszámlaszám>
COMPANY_EMAIL=<ügyfélszolgálati e-mail>
COMPANY_PHONE=<ügyfélszolgálati telefon>

# Tárhelyszolgáltató — Ekertv. 4. § alapján kötelező feltüntetni
HOSTING_NAME=Hetzner Online GmbH
HOSTING_ADDRESS=Industriestr. 25, 91710 Gunzenhausen, Németország
HOSTING_EMAIL=info@hetzner.com

# Békéltető testület — a SZÉKHELY szerint illetékeset add meg!
ARBITRATION_BOARD=Budapesti Békéltető Testület
ARBITRATION_ADDRESS=1016 Budapest, Krisztina krt. 99. III. em. 310.
ARBITRATION_EMAIL=bekelteto.testulet@bkik.hu

# A jogi szövegek hatálybalépése (ÉÉÉÉ-HH-NN)
LEGAL_EFFECTIVE_FROM=<pl. 2026-09-01>


# ══════════════════════════════════════════════════════════════════
#  6. BARION — ÉLES
#  Barion admin → Shopok → (a bolt) → Szerkesztés
# ══════════════════════════════════════════════════════════════════
BARION_ENV=prod
BARION_POS_KEY=<ÉLES Secret key>                  # [TITKOS] soha ne oszd meg
BARION_PAYEE=<az éles Barion fiókod e-mail címe>
BARION_SHOP_ID=<ÉLES Public key>                  # [nyilvános]
BARION_PIXEL_ID=<ÉLES Barion Pixel Id>            # [nyilvános]
BARION_LOCALE=hu-HU
BARION_GUEST_CHECKOUT=true
BARION_FUNDING_SOURCES=All
# .NET TimeSpan formátum (d.hh:mm:ss) — NEM ISO 8601!
BARION_PAYMENT_WINDOW=1.00:00:00

# A Barion Pixel csak hozzájárulás után töltődjön be
PIXEL_REQUIRES_CONSENT=true


# ══════════════════════════════════════════════════════════════════
#  7. E-MAIL (Brevo / Resend / saját SMTP)
# ══════════════════════════════════════════════════════════════════
MAIL_ENABLED=true
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp felhasználó>
SMTP_PASS=<smtp jelszó>                            # [TITKOS]
MAIL_FROM=BRIGHTAL <hello@brightal.hu>


# ══════════════════════════════════════════════════════════════════
#  8. SZÁMLÁZÁS (NAV online számla — élesben kötelező)
# ══════════════════════════════════════════════════════════════════
INVOICE_ENABLED=true
INVOICE_PROVIDER=szamlazz
SZAMLAZZ_AGENT_KEY=<Számlázz.hu Agent kulcs>       # [TITKOS]
# vagy Billingo esetén:
BILLINGO_API_KEY=                                  # [TITKOS]
BILLINGO_BLOCK_ID=
BILLINGO_BANK_ACCOUNT_ID=
INVOICE_SEND_TO_CUSTOMER=true
INVOICE_PAYMENT_METHOD=bankkártya
INVOICE_VAT_RATE_LABEL=27
INVOICE_ITEM_NAME=Egyedi készítésű gyűrű
INVOICE_COMMENT=


# ══════════════════════════════════════════════════════════════════
#  9. GOOGLE BELÉPÉS (opcionális)                      [nyilvános]
#  console.cloud.google.com → Credentials → OAuth client ID
#  Authorized JavaScript origins: https://brightal.hu
# ══════════════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=


# ══════════════════════════════════════════════════════════════════
#  10. PINTEREST (opcionális)                          [nyilvános]
# ══════════════════════════════════════════════════════════════════
PINTEREST_BOARD_HU=
PINTEREST_BOARD_EN=


# ══════════════════════════════════════════════════════════════════
#  ELLENŐRZŐ LISTA az indítás után
#  ─────────────────────────────────────────────────────────────────
#  systemctl restart brightal && journalctl -u brightal -n 40
#
#  A konzolon EZT kell látnod:
#     Barion       : ÉLES (production) → https://api.barion.com
#     Fizetés mód  : ✔  valódi Barion API
#     E-mail       : ✔  SMTP aktív
#     Számlázás    : ✔  szamlazz
#     jelszó tár.  : ✔  scrypt hash
#
#  Ha „ÉLESÍTÉSI FIGYELMEZTETÉSEK" blokk jelenik meg,
#  pótold a felsorolt hiányosságokat.
# ══════════════════════════════════════════════════════════════════
